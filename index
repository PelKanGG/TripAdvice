<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
  crossorigin=""></script>
<script>
// ───────────────────────── Storage ─────────────────────────
const LS_MAP   = 'better-been:map-status:v1';
const LS_TRIP  = 'better-been:trip:v1';

let mapStatus = JSON.parse(localStorage.getItem(LS_MAP) || '{}');
let mode      = 'visited'; // visited | wishlist
let trip      = JSON.parse(localStorage.getItem(LS_TRIP)) || {
  name: 'Italien 2026',
  members: [
    { id: 'm1', name: 'Tom'  },
    { id: 'm2', name: 'Anna' },
    { id: 'm3', name: 'Luca' },
  ],
  expenses: [],
  percentages: {},
};
if (!trip.percentages) trip.percentages = {};

const saveMap  = () => localStorage.setItem(LS_MAP, JSON.stringify(mapStatus));
const saveTrip = () => localStorage.setItem(LS_TRIP, JSON.stringify(trip));

// ───────────────────────── Tabs ─────────────────────────
const $$ = sel => document.querySelectorAll(sel);
const $  = sel => document.querySelector(sel);

$$('.nav-item').forEach(btn => {
  btn.addEventListener('click', () => {
    const tab = btn.dataset.tab;
    $$('.nav-item').forEach(n => n.classList.toggle('active', n === btn));
    $$('.tab').forEach(t => t.classList.toggle('active', t.id === `tab-${tab}`));
    const showMapCtrls = tab === 'map';
    $('#level-controls').style.display = showMapCtrls ? 'inline-flex' : 'none';
    $('#mode-controls').classList.toggle('show', showMapCtrls);
    if (showMapCtrls && map) setTimeout(() => map.invalidateSize(), 50);
    if (showMapCtrls) closeSplitScreen();
  });
});

// ───────────────────────── Map ─────────────────────────
// Canvas-Renderer: massiver Performance-Gewinn bei den ~4500 Polygonen der
// 10m-Subdivisions im Vergleich zum Default-SVG-Renderer.
const map = L.map('map', {
  zoomControl: true,
  worldCopyJump: true,
  renderer: L.canvas({ padding: 0.5 }),
}).setView([25, 10], 2);

// CartoDB Positron — base ohne Labels, damit Polygone darüber liegen können
L.tileLayer('https://{s}.basemaps.cartocdn.com/light_nolabels/{z}/{x}/{y}{r}.png', {
  attribution: '© OpenStreetMap, © CartoDB',
  subdomains: 'abcd',
  maxZoom: 8, minZoom: 2,
}).addTo(map);

// Eigene Pane für Labels: über Polygonen, unter Tooltips. So sind Städte-/Ländernamen
// auch über mint/peach-gefärbten Ländern noch klar lesbar.
map.createPane('labels');
map.getPane('labels').style.zIndex = 650;
map.getPane('labels').style.pointerEvents = 'none';
L.tileLayer('https://{s}.basemaps.cartocdn.com/light_only_labels/{z}/{x}/{y}{r}.png', {
  attribution: '',
  subdomains: 'abcd',
  maxZoom: 8, minZoom: 2,
  pane: 'labels',
}).addTo(map);

let level = 'country';                  // 'country' | 'subdivision'
let layers = { country: null, subdivision: null, countryOutline: null };
let dataCache = { country: null, subdivision: null };
let totals = { country: 0, subdivision: 0 };

// Fallback-Chain pro Layer: erst lokale committete Files probieren (schnell wenn
// auf GitHub Pages), dann CDN. Bei file:// wird local übersprungen, weil Chrome
// fetch zu relativen Pfaden aus file:// blockt.
const _isLocalFile = location.protocol === 'file:';
const GEO_URLS = {
  country: [
    'data/countries.geojson',
    'https://cdn.jsdelivr.net/gh/nvkelso/natural-earth-vector@master/geojson/ne_50m_admin_0_map_subunits.geojson',
  ],
  subdivision: [
    'data/subdivisions.geojson',
    // jsdelivr blockt bei >20 MB → raw.githubusercontent.com für 10m
    'https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_10m_admin_1_states_provinces.geojson',
  ],
};

function codeOf(feature, lvl) {
  const p = feature.properties;
  if (lvl === 'country') {
    // ISO_A2 kann '-99' sein für Kosovo, N. Cyprus etc. → ISO_A2_EH als Fallback
    const raw = p.ISO_A2 || p.iso_a2;
    let iso2 = (raw && raw !== '-99') ? raw : (p.ISO_A2_EH || p.iso_a2_eh);
    if (!iso2 || iso2 === '-99') iso2 = (p.SOV_A3 || p.sov_a3 || 'XX').slice(0, 2);
    // SU_DIF=1 → Subunit (z.B. England in UK, Greenland in DK).
    // Eindeutiger Composite-Key: GB-ENG, GB-SCT, GL-GRL, HK-HKG …
    // Vorteil: matcht beim Wechsel zu Regionen den ISO 3166-2 Code (GB-ENG).
    const isSubunit = Number(p.SU_DIF) === 1;
    return isSubunit ? `${iso2}-${p.SU_A3}` : iso2;
  }
  // subdivisions: ISO 3166-2 ist die schönste Form, aber nicht jede Region hat
  // eine. Fallback auf HASC, GeoNames-ID, oder synthetisch aus Parent+Name.
  let code = p.iso_3166_2 || p.code_hasc;
  if (!code || code === '' || code.endsWith('~')) {
    const parent = (p.iso_a2 || p.adm0_a3 || 'XX').toUpperCase();
    const slug = (p.name_en || p.name || 'unknown')
      .normalize('NFD').replace(/[̀-ͯ]/g, '')
      .replace(/[^A-Za-z0-9]+/g, '_').replace(/^_|_$/g, '');
    code = `${parent}-${slug}`;
  }
  return code;
}
function nameOf(feature) {
  const p = feature.properties;
  // Subunits: SUBUNIT (z.B. "England") statt ADMIN ("United Kingdom")
  if (Number(p.SU_DIF) === 1 && (p.SUBUNIT || p.subunit)) {
    return p.SUBUNIT || p.subunit;
  }
  return p.ADMIN || p.NAME || p.name || p.name_en || '';
}

// ─── Geodesic polygon area (km²) — Turf.js-style spherical excess ───
const featureAreas = new Map();   // code -> km²
let totalWorldArea = 0;
const toRad = d => d * Math.PI / 180;

function ringArea(coords) {
  if (coords.length < 3) return 0;
  const R = 6378137; // WGS84 mean radius (m)
  let area = 0;
  for (let i = 0; i < coords.length - 1; i++) {
    const p1 = coords[i];
    const p2 = coords[(i + 1) % coords.length];
    const p3 = coords[(i + 2) % coords.length];
    area += (toRad(p3[0]) - toRad(p1[0])) * Math.sin(toRad(p2[1]));
  }
  return Math.abs(area * R * R / 2);
}
function geometryAreaKm2(geom) {
  if (!geom) return 0;
  const polyArea = poly => {
    let a = ringArea(poly[0]);
    for (let i = 1; i < poly.length; i++) a -= ringArea(poly[i]);
    return a;
  };
  let m2 = 0;
  if (geom.type === 'Polygon') m2 = polyArea(geom.coordinates);
  else if (geom.type === 'MultiPolygon') m2 = geom.coordinates.reduce((s, p) => s + polyArea(p), 0);
  return m2 / 1e6;
}

function worldCoveragePercent(status) {
  if (!totalWorldArea) return 0;
  // Country marks shadow their subdivisions — don't double-count
  const sameLevelCountries = new Set(
    Object.keys(mapStatus).filter(k => !k.includes('-') && mapStatus[k] === status),
  );
  let area = 0;
  for (const code in mapStatus) {
    if (mapStatus[code] !== status) continue;
    const a = featureAreas.get(code);
    if (!a) continue;
    if (code.includes('-')) {
      const parent = code.slice(0, code.indexOf('-'));
      if (sameLevelCountries.has(parent)) continue; // parent already counted
    }
    area += a;
  }
  return (area / totalWorldArea) * 100;
}
function formatPct(p) {
  if (p < 0.05) return '0 %';
  if (p < 9.95) return p.toFixed(1) + ' %';
  return Math.round(p) + ' %';
}

function statusColor(status) {
  if (status === 'visited')  return '#B8E0D2';
  if (status === 'wishlist') return '#FAD4C0';
  return '#F4F4F2';
}

function styleFor(lvl) {
  const baseWeight = lvl === 'subdivision' ? 0.4 : 0.6;
  return feature => ({
    fillColor: statusColor(mapStatus[codeOf(feature, lvl)]),
    weight: baseWeight,
    color: '#D9D9D9',
    fillOpacity: 0.9,
  });
}

function showToast(msg) {
  const t = $('#toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(showToast._t);
  showToast._t = setTimeout(() => t.classList.remove('show'), 1600);
}

function refreshStats() {
  const isCountry = level === 'country';
  const isLevelKey = code => isCountry ? !code.includes('-') : code.includes('-');
  const codes = Object.keys(mapStatus).filter(isLevelKey);
  const v = codes.filter(c => mapStatus[c] === 'visited').length;
  const w = codes.filter(c => mapStatus[c] === 'wishlist').length;
  const total = totals[level] || 0;

  $('#stat-visited').textContent  = total ? `${v}/${total}` : `${v}`;
  $('#stat-wishlist').textContent = total ? `${w}/${total}` : `${w}`;

  // Welt = Fläche % | Länder %
  const areaPct = worldCoveragePercent('visited');
  const visitedCountries = Object.keys(mapStatus)
    .filter(c => !c.includes('-') && mapStatus[c] === 'visited').length;
  const countryPct = totals.country
    ? (visitedCountries / totals.country) * 100
    : 0;
  $('#stat-coverage').textContent = `${formatPct(areaPct)} | ${formatPct(countryPct)}`;
  $('#stat-coverage-sub').textContent = 'Fläche · Länder';
  $('#stat-coverage-label').textContent = 'der welt';
}

function onFeatureClick(e, lvl) {
  const code = codeOf(e.target.feature, lvl);
  const name = nameOf(e.target.feature);
  if (!code || code === '-99') return;

  if (mapStatus[code] === mode) {
    delete mapStatus[code];
    showToast(`${name} entfernt`);
  } else {
    mapStatus[code] = mode;
    showToast(`${name} → ${mode === 'visited' ? 'besucht' : 'wunsch'}`);
  }
  saveMap();
  e.target.setStyle(styleFor(lvl)(e.target.feature));
  refreshStats();
}

function buildLayer(data, lvl) {
  const styled = styleFor(lvl);
  const baseWeight = lvl === 'subdivision' ? 0.4 : 0.6;
  return L.geoJSON(data, {
    style: styled,
    onEachFeature: (feature, layer) => {
      layer.bindTooltip(nameOf(feature), { sticky: true });
      layer.on('click', e => onFeatureClick(e, lvl));
      layer.on('mouseover', () => layer.setStyle({ weight: 1.5, color: '#6C8EBF' }));
      layer.on('mouseout',  () => layer.setStyle({ weight: baseWeight, color: '#D9D9D9' }));
    },
  });
}

async function loadLevel(target) {
  if (dataCache[target]) return dataCache[target];
  $('#loader').innerHTML = '<div class="spinner"></div><div></div>';
  $('#loader').classList.remove('hidden');
  $('#loader').querySelector('div + div').textContent =
    target === 'country'
      ? 'Karte wird geladen…'
      : 'Detaillierte Regionen werden geladen — beim 1. Mal etwas Geduld, danach gecached…';

  // Fallback-Chain durchgehen
  const urls = GEO_URLS[target];
  let data = null, lastErr;
  for (const url of urls) {
    // Local files aus file:// nicht versuchen (Chrome blockt)
    if (_isLocalFile && !url.startsWith('http')) continue;
    try {
      const r = await fetch(url);
      if (!r.ok) { lastErr = new Error(`HTTP ${r.status} for ${url}`); continue; }
      data = await r.json();
      break;
    } catch (e) { lastErr = e; }
  }
  if (!data) throw lastErr || new Error('Keine Quelle erreichbar');
  // Country-Layer: Dependencies (Bermuda, Falklands…) und Disputed (Kosovo,
  // N. Cyprus…) rausfiltern — sonst explodiert der Nenner über 270.
  // Bleibt: 'Sovereign country' + 'Country' (UK-Subunits, Greenland etc.) ≈ 200.
  if (target === 'country') {
    data.features = data.features.filter(f => {
      const t = f.properties.TYPE || f.properties.type;
      return t === 'Sovereign country' || t === 'Country';
    });
  }
  dataCache[target] = data;
  // compute + cache area per feature
  let levelTotal = 0;
  for (const f of data.features) {
    const code = codeOf(f, target);
    if (!code || code === '-99') continue;
    const a = geometryAreaKm2(f.geometry);
    featureAreas.set(code, a);
    levelTotal++;
  }
  totals[target] = levelTotal;
  if (target === 'country') {
    totalWorldArea = data.features.reduce((s, f) => {
      const c = codeOf(f, 'country');
      return c && c !== '-99' ? s + (featureAreas.get(c) || 0) : s;
    }, 0);
  }
  return data;
}

async function showLevel(target) {
  level = target;
  if (layers.country)        map.removeLayer(layers.country);
  if (layers.subdivision)    map.removeLayer(layers.subdivision);
  if (layers.countryOutline) map.removeLayer(layers.countryOutline);

  try {
    if (target === 'country') {
      const data = await loadLevel('country');
      if (!layers.country) layers.country = buildLayer(data, 'country');
      layers.country.addTo(map);
    } else {
      const subData = await loadLevel('subdivision');
      const cntData = await loadLevel('country');
      if (!layers.subdivision) layers.subdivision = buildLayer(subData, 'subdivision');
      layers.subdivision.addTo(map);
      // Länder-Umrisse als Overlay (nicht klickbar) für Orientierung
      if (!layers.countryOutline) {
        layers.countryOutline = L.geoJSON(cntData, {
          style: { fill: false, color: '#1F2933', weight: 1.2, opacity: 0.45 },
          interactive: false,
        });
      }
      layers.countryOutline.addTo(map);
    }
    $('#loader').classList.add('hidden');
    refreshStats();
  } catch (err) {
    console.error(err);
    const loader = $('#loader');
    loader.innerHTML =
      '<div style="text-align:center; padding:0 24px; max-width: 320px">' +
      '<strong style="display:block; margin-bottom:8px">Konnte nicht geladen werden.</strong>' +
      '<small style="color:var(--muted); display:block; margin-bottom:16px">Internetverbindung prüfen.</small>' +
      '<button id="retry-btn" style="background:var(--ink); color:white; border:none; border-radius:10px; padding:10px 20px; font-weight:700; cursor:pointer">Erneut versuchen</button>' +
      '</div>';
    loader.classList.remove('hidden');
    $('#retry-btn').addEventListener('click', () => {
      delete dataCache[target];
      showLevel(target);
    });
  }
}

// initial load
showLevel('country').then(() => {
  $('#level-controls').style.display = 'inline-flex';
  $('#mode-controls').classList.add('show');
  // Wenn Regionen-Marks aus früherer Session existieren, im Hintergrund nachladen
  // damit die Welt-Coverage stimmt — User merkt nichts davon.
  const hasSubMarks = Object.keys(mapStatus).some(c => c.includes('-'));
  if (hasSubMarks) {
    loadLevel('subdivision').then(refreshStats).catch(() => {});
  }
});

// Level toggle (country / subdivision)
$$('#level-controls button').forEach(btn => {
  btn.addEventListener('click', () => {
    if (btn.classList.contains('active')) return;
    $$('#level-controls button').forEach(b => b.classList.toggle('active', b === btn));
    showLevel(btn.dataset.level);
  });
});

// Mode toggle (visited / wishlist) — floating on map
$$('#mode-controls button').forEach(btn => {
  btn.addEventListener('click', () => {
    $$('#mode-controls button').forEach(b => b.classList.toggle('active', b === btn));
    mode = btn.dataset.mode;
  });
});

// ───────────────────────── Splitter ─────────────────────────
function uid() { return 'x' + Math.random().toString(36).slice(2, 9); }

function renderMembers() {
  const card = $('#members-card');
  const rows = trip.members.map(m => `
    <div class="row">
      <div class="icon ic-blue">${m.name.charAt(0).toUpperCase()}</div>
      <div class="body">
        <div class="t">${escapeHtml(m.name)}</div>
      </div>
      ${trip.members.length > 1 ? `<button class="del" data-rm="${m.id}">✕</button>` : ''}
    </div>
  `).join('');
  card.innerHTML = rows + `
    <div class="add-member">
      <input id="new-member" type="text" placeholder="Name hinzufügen…" maxlength="20">
      <button id="add-member-btn">+</button>
    </div>
  `;
  card.querySelectorAll('[data-rm]').forEach(b => {
    b.addEventListener('click', () => removeMember(b.dataset.rm));
  });
  $('#add-member-btn').addEventListener('click', addMember);
  $('#new-member').addEventListener('keydown', e => {
    if (e.key === 'Enter') addMember();
  });
}

function addMember() {
  const inp = $('#new-member');
  const name = inp.value.trim();
  if (!name) return;
  trip.members.push({ id: uid(), name });
  trip.percentages = equalPercentages();
  saveTrip();
  renderAll();
}

function removeMember(id) {
  if (trip.expenses.some(e => e.payer === id)) {
    if (!confirm('Diese Person hat Ausgaben — wirklich entfernen? Ausgaben bleiben dem Trip erhalten, aber die Bilanz stimmt evtl. nicht mehr.')) return;
  }
  trip.members = trip.members.filter(m => m.id !== id);
  trip.percentages = equalPercentages();
  saveTrip();
  renderAll();
}

function equalPercentages() {
  const n = trip.members.length;
  if (n === 0) return {};
  const each = +(100 / n).toFixed(2);
  const result = Object.fromEntries(trip.members.map(m => [m.id, each]));
  // fix rounding so total = 100
  const sum = Object.values(result).reduce((a, b) => a + b, 0);
  result[trip.members[0].id] = +(result[trip.members[0].id] + (100 - sum)).toFixed(2);
  return result;
}

function effectivePercentages() {
  const pcts = trip.percentages || {};
  const allPresent = trip.members.length > 0 &&
    trip.members.every(m => typeof pcts[m.id] === 'number');
  return allPresent ? pcts : equalPercentages();
}

function totalSpent() {
  return trip.expenses.reduce((s, e) => s + e.amount, 0);
}

function balances() {
  const result = Object.fromEntries(trip.members.map(m => [m.id, 0]));
  if (trip.members.length === 0) return result;
  const pcts = effectivePercentages();
  trip.expenses.forEach(e => {
    trip.members.forEach(m => {
      result[m.id] -= e.amount * (pcts[m.id] || 0) / 100;
    });
    if (result[e.payer] !== undefined) result[e.payer] += e.amount;
  });
  return result;
}

function simplify(bals) {
  const creditors = [], debtors = [];
  Object.entries(bals).forEach(([id, b]) => {
    if (b > 0.01)  creditors.push({ id, amt: b });
    if (b < -0.01) debtors.push({ id, amt: -b });
  });
  creditors.sort((a, b) => b.amt - a.amt);
  debtors.sort((a, b) => b.amt - a.amt);
  const res = [];
  let i = 0, j = 0;
  while (i < debtors.length && j < creditors.length) {
    const pay = Math.min(debtors[i].amt, creditors[j].amt);
    res.push({ from: debtors[i].id, to: creditors[j].id, amt: pay });
    debtors[i].amt -= pay;
    creditors[j].amt -= pay;
    if (debtors[i].amt < 0.01) i++;
    if (creditors[j].amt < 0.01) j++;
  }
  return res;
}

function renderTotalCard() {
  $('#total-amount').textContent = money(totalSpent());
  $('#total-count').textContent = trip.expenses.length;
  const btn = $('#open-split-btn');
  const ready = trip.expenses.length > 0 && trip.members.length >= 2;
  btn.disabled = !ready;
}

function renderSplitScreen() {
  const total = totalSpent();
  $('#split-total').textContent = money(total);
  $('#split-count').textContent = trip.expenses.length;

  const pcts = effectivePercentages();
  const card = $('#pct-card');
  card.innerHTML = trip.members.map(m => {
    const p = pcts[m.id] || 0;
    const share = total * p / 100;
    return `
      <div class="pct-row" data-row="${m.id}">
        <div class="icon ic-blue">${m.name.charAt(0).toUpperCase()}</div>
        <div class="body">
          <div class="t">${escapeHtml(m.name)}</div>
          <div class="s">trägt ${money(share)}</div>
        </div>
        <div class="pct-input-wrap">
          <input class="pct-input" type="number" min="0" max="100" step="0.5"
                 value="${p}" data-member="${m.id}">
          <span class="pct-suffix">%</span>
        </div>
      </div>
    `;
  }).join('');

  // Debounce der schwereren Operationen (Sum-Update + Settlement-Recompute)
  // damit das Tippen nicht ruckelt — pro Zeile sind die Share-Texte sofort aktiv.
  const debouncedRecompute = debounce(() => {
    updateSumIndicator();
    renderSplitSettlements();
  }, 150);

  card.querySelectorAll('.pct-input').forEach(inp => {
    inp.addEventListener('input', e => {
      const id = e.target.dataset.member;
      const v = Math.max(0, Math.min(100, parseFloat(e.target.value) || 0));
      trip.percentages[id] = v;
      saveTrip();
      // Sofortiges Feedback nur für die getippte Zeile
      const row = card.querySelector(`[data-row="${id}"] .body .s`);
      if (row) row.textContent = `trägt ${money(totalSpent() * v / 100)}`;
      debouncedRecompute();
    });
  });

  updateSumIndicator();
  renderSplitSettlements();
}

function updateSumIndicator() {
  const pcts = effectivePercentages();
  const sum = Object.values(pcts).reduce((a, b) => a + (Number(b) || 0), 0);
  const ind = $('#sum-indicator');
  const rounded = Math.round(sum * 10) / 10;
  if (Math.abs(sum - 100) < 0.5) {
    ind.innerHTML = `Summe: 100% ✓`;
    ind.classList.remove('invalid');
  } else {
    ind.innerHTML =
      `Summe: ${rounded}% — sollte 100% sein ` +
      `<button id="auto-normalize-btn" class="auto-norm-btn">Auto-normalisieren</button>`;
    ind.classList.add('invalid');
    $('#auto-normalize-btn').addEventListener('click', autoNormalize);
  }
}

function autoNormalize() {
  const pcts = { ...trip.percentages };
  const sum = Object.values(pcts).reduce((a, b) => a + (Number(b) || 0), 0);
  if (sum === 0) {
    trip.percentages = equalPercentages();
  } else {
    const factor = 100 / sum;
    const out = {};
    for (const [id, v] of Object.entries(pcts)) out[id] = +(v * factor).toFixed(2);
    // Rundungs-Korrektur, sodass exakt 100
    const ns = Object.values(out).reduce((a, b) => a + b, 0);
    if (trip.members.length > 0) {
      out[trip.members[0].id] = +(out[trip.members[0].id] + (100 - ns)).toFixed(2);
    }
    trip.percentages = out;
  }
  saveTrip();
  renderSplitScreen();
}

function renderSplitSettlements() {
  const card = $('#settlements-card');
  if (trip.expenses.length === 0) {
    card.innerHTML = '<div class="empty">Noch keine Ausgaben.</div>';
    return;
  }
  const settlements = simplify(balances());
  if (settlements.length === 0) {
    card.innerHTML = '<div class="empty">Alle quitt. ✨</div>';
    return;
  }
  const nameOf = id => (trip.members.find(m => m.id === id) || { name: '?' }).name;
  card.innerHTML = settlements.map(s => `
    <div class="row">
      <div class="icon ic-peach">${nameOf(s.from).charAt(0).toUpperCase()}</div>
      <div class="body">
        <div class="t">${escapeHtml(nameOf(s.from))} → ${escapeHtml(nameOf(s.to))}</div>
        <div class="s">Vorgeschlagene Zahlung</div>
      </div>
      <div class="amt">${money(s.amt)}</div>
    </div>
  `).join('');
}

function openSplitScreen() {
  // Initialize percentages if missing/stale
  const valid = trip.members.length > 0 &&
    trip.members.every(m => typeof trip.percentages[m.id] === 'number');
  if (!valid) {
    trip.percentages = equalPercentages();
    saveTrip();
  }
  renderSplitScreen();
  $('#split-screen').classList.add('show');
}

function closeSplitScreen() {
  $('#split-screen').classList.remove('show');
}

function equalizeSplit() {
  trip.percentages = equalPercentages();
  saveTrip();
  renderSplitScreen();
}

function renderExpenses() {
  const card = $('#expenses-card');
  if (trip.expenses.length === 0) {
    card.innerHTML = '<div class="empty">Tippe auf <strong>＋ Ausgabe</strong> unten rechts.</div>';
    return;
  }
  const nameOf = id => (trip.members.find(m => m.id === id) || { name: '?' }).name;
  const sorted = [...trip.expenses].sort((a, b) => b.date - a.date);
  card.innerHTML = sorted.map(e => `
    <div class="row">
      <div class="icon ic-mint">€</div>
      <div class="body">
        <div class="t">${escapeHtml(e.desc || 'Ausgabe')}</div>
        <div class="s">${escapeHtml(nameOf(e.payer))} · ${formatDate(e.date)}</div>
      </div>
      <div class="amt">${money(e.amount)}</div>
      <button class="del" data-rm-exp="${e.id}">✕</button>
    </div>
  `).join('');
  card.querySelectorAll('[data-rm-exp]').forEach(b => {
    b.addEventListener('click', () => removeExpense(b.dataset.rmExp));
  });
}

function removeExpense(id) {
  trip.expenses = trip.expenses.filter(e => e.id !== id);
  saveTrip();
  renderAll();
}

function renderAll() {
  renderMembers();
  renderTotalCard();
  renderExpenses();
  if ($('#split-screen').classList.contains('show')) renderSplitScreen();
}

// ───── Modal ─────
function openExpenseModal() {
  if (trip.members.length === 0) {
    alert('Erst mindestens eine Person hinzufügen.');
    return;
  }
  $('#exp-amount').value = '';
  $('#exp-desc').value   = '';
  const sel = $('#exp-payer');
  sel.innerHTML = trip.members.map(m =>
    `<option value="${m.id}">${escapeHtml(m.name)}</option>`).join('');
  $('#expense-modal').classList.add('show');
  setTimeout(() => $('#exp-amount').focus(), 50);
}

function closeExpenseModal() {
  $('#expense-modal').classList.remove('show');
}

function saveExpense() {
  const amount = parseFloat($('#exp-amount').value.replace(',', '.'));
  if (!amount || amount <= 0) {
    $('#exp-amount').focus();
    return;
  }
  trip.expenses.push({
    id: uid(),
    payer: $('#exp-payer').value,
    amount,
    desc: $('#exp-desc').value.trim(),
    date: Date.now(),
  });
  saveTrip();
  closeExpenseModal();
  renderAll();
}

$('#add-expense-btn').addEventListener('click', openExpenseModal);
$('#exp-cancel').addEventListener('click', closeExpenseModal);
$('#exp-save').addEventListener('click', saveExpense);
$('#open-split-btn').addEventListener('click', openSplitScreen);
$('#close-split-btn').addEventListener('click', closeSplitScreen);
$('#equal-split-btn').addEventListener('click', equalizeSplit);
$('#expense-modal').addEventListener('click', e => {
  if (e.target.id === 'expense-modal') closeExpenseModal();
});

// Trip name
$('#trip-name').value = trip.name;
$('#trip-name').addEventListener('change', e => {
  trip.name = e.target.value.trim() || 'Mein Trip';
  saveTrip();
});

$('#reset-trip').addEventListener('click', () => {
  if (!confirm('Alle Ausgaben löschen?')) return;
  trip.expenses = [];
  saveTrip();
  renderAll();
});

// ───── Trip Export / Import ─────
$('#trip-export-btn').addEventListener('click', () => {
  const blob = new Blob([JSON.stringify(trip, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  const safeName = (trip.name || 'trip').replace(/[^A-Za-z0-9_-]+/g, '_');
  a.href = url;
  a.download = `better-been-${safeName}.json`;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
});

$('#trip-import-btn').addEventListener('click', () => {
  $('#import-json').value = '';
  $('#import-modal').classList.add('show');
  setTimeout(() => $('#import-json').focus(), 50);
});
$('#import-cancel').addEventListener('click', () => $('#import-modal').classList.remove('show'));
$('#import-modal').addEventListener('click', e => {
  if (e.target.id === 'import-modal') $('#import-modal').classList.remove('show');
});
$('#import-save').addEventListener('click', () => {
  const raw = $('#import-json').value.trim();
  if (!raw) return;
  try {
    const parsed = JSON.parse(raw);
    if (!parsed.members || !Array.isArray(parsed.members)) throw new Error('Kein gültiger Trip (members fehlen)');
    if (!parsed.expenses || !Array.isArray(parsed.expenses)) throw new Error('Kein gültiger Trip (expenses fehlen)');
    trip = {
      name: parsed.name || 'Importierter Trip',
      members: parsed.members,
      expenses: parsed.expenses,
      percentages: parsed.percentages || {},
    };
    saveTrip();
    $('#trip-name').value = trip.name;
    $('#import-modal').classList.remove('show');
    renderAll();
  } catch (err) {
    alert('Import fehlgeschlagen: ' + err.message);
  }
});

// ───── Helpers ─────
function money(eur) {
  return new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(eur);
}
function formatDate(ts) {
  const d = new Date(ts);
  return d.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit' });
}
function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, c => ({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
  }[c]));
}
function debounce(fn, ms) {
  let t;
  return (...args) => {
    clearTimeout(t);
    t = setTimeout(() => fn(...args), ms);
  };
}

// Initial render
renderAll();
</script>

