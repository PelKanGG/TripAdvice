<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Better-Been · Web Edition</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
<style>
  :root {
    --visited:   #B8E0D2;
    --wishlist:  #FAD4C0;
    --unvisited: #F4F4F2;
    --border:    #D9D9D9;
    --accent:    #6C8EBF;
    --ink:       #1F2933;
    --muted:     #6B7280;
    --surface:   #FAFAF7;
    --canvas:    #ECEAE3;
    --shadow:    0 12px 32px -16px rgba(31, 41, 51, 0.18);
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; }
  body {
    font-family: 'Manrope', -apple-system, sans-serif;
    background: var(--canvas);
    color: var(--ink);
    overflow: hidden;
    -webkit-font-smoothing: antialiased;
  }

  /* Layout */
  .app {
    height: 100vh;
    max-width: 920px;
    margin: 0 auto;
    background: var(--surface);
    border-left: 1px solid var(--border);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    position: relative;
  }
  @media (min-width: 921px) {
    body { padding: 24px 0; }
    .app {
      height: calc(100vh - 48px);
      border-radius: 24px;
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      overflow: hidden;
    }
  }

  /* Top bar */
  .topbar {
    padding: 16px 20px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .topbar h1 {
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.02em;
  }
  .topbar h1 span { color: var(--accent); }

  .segmented {
    display: inline-flex;
    background: white;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 3px;
    font-size: 12px;
    font-weight: 600;
  }
  .segmented button {
    border: none;
    background: transparent;
    padding: 6px 12px;
    border-radius: 7px;
    color: var(--muted);
    cursor: pointer;
    font: inherit;
    font-weight: 600;
  }
  .segmented button.active {
    background: var(--ink);
    color: white;
  }

  /* Tabs */
  .tab { display: none; flex: 1; min-height: 0; flex-direction: column; }
  .tab.active { display: flex; }

  /* ─── Map tab ─── */
  #map { flex: 1; background: var(--canvas); }
  .leaflet-container { background: #E5EDF7; font-family: inherit; }
  .leaflet-popup-content-wrapper { border-radius: 12px; }

  .stats {
    display: flex;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .stat {
    flex: 1;
    background: white;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 10px 14px;
  }
  .stat .num { font-weight: 800; font-size: 20px; letter-spacing: -0.02em; }
  .stat .sub { font-size: 11px; font-weight: 700; color: var(--ink); margin-top: 1px; letter-spacing: -0.01em; }
  .stat .label { font-size: 11px; color: var(--muted); margin-top: 2px; }
  .stat.visited  .num { color: #2E7D5B; }
  .stat.wishlist .num { color: #B14A3E; }

  .legend {
    position: absolute;
    bottom: 100px;
    left: 16px;
    background: rgba(255,255,255,0.94);
    backdrop-filter: blur(6px);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 8px 12px;
    display: flex;
    gap: 12px;
    font-size: 11px;
    font-weight: 600;
    z-index: 500;
    pointer-events: none;
  }

  .map-mode {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(255,255,255,0.96);
    backdrop-filter: blur(6px);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 8px 10px 8px 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    z-index: 500;
    box-shadow: 0 8px 24px -12px rgba(31, 41, 51, 0.25);
    display: none;
  }
  .map-mode.show { display: flex; }
  .map-mode .mode-label {
    font-size: 10px;
    font-weight: 700;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .mode-seg {
    padding: 2px;
  }
  .mode-seg button {
    padding: 5px 10px;
    font-size: 11px;
  }
  @media (max-width: 480px) {
    .map-mode .mode-label { display: none; }
  }
  .legend .dot {
    display: inline-block;
    width: 10px; height: 10px;
    border-radius: 50%;
    margin-right: 5px;
    border: 1px solid var(--border);
    vertical-align: middle;
  }

  .toast {
    position: absolute;
    bottom: 110px;
    left: 50%;
    transform: translateX(-50%) translateY(20px);
    background: var(--ink);
    color: white;
    padding: 10px 16px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    opacity: 0;
    pointer-events: none;
    transition: all 0.25s ease;
    z-index: 600;
  }
  .toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* ─── Splitter tab ─── */
  .splitter {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .trip-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .trip-name {
    font-weight: 800;
    font-size: 24px;
    letter-spacing: -0.02em;
    background: transparent;
    border: none;
    flex: 1;
    color: var(--ink);
    font-family: inherit;
  }
  .trip-name:focus { outline: 2px solid var(--accent); border-radius: 6px; padding: 0 4px; }
  .trip-action-btn {
    flex-shrink: 0;
  }

  .section-title {
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 4px 4px -8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .section-title .ghost-btn {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 4px 10px;
    font: inherit;
    font-weight: 600;
    font-size: 11px;
    color: var(--muted);
    cursor: pointer;
  }
  .section-title .ghost-btn:hover { color: var(--ink); border-color: var(--ink); }

  .card {
    background: white;
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
  }
  .row {
    padding: 14px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid var(--border);
  }
  .row:last-child { border-bottom: none; }
  .row .icon {
    width: 36px; height: 36px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px; font-weight: 700;
    flex-shrink: 0;
  }
  .row .body { flex: 1; min-width: 0; }
  .row .body .t {
    font-weight: 600;
    font-size: 14px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .row .body .s {
    font-size: 12px;
    color: var(--muted);
    margin-top: 2px;
  }
  .row .amt {
    font-weight: 700;
    font-size: 14px;
    letter-spacing: -0.01em;
    flex-shrink: 0;
  }
  .row .del {
    background: transparent;
    border: none;
    color: var(--muted);
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 14px;
  }
  .row .del:hover { background: var(--unvisited); color: var(--ink); }

  .ic-mint   { background: var(--visited);  color: var(--ink); }
  .ic-peach  { background: var(--wishlist); color: var(--ink); }
  .ic-blue   { background: #DCE5F2; color: var(--accent); }
  .ic-grey   { background: var(--unvisited); color: var(--ink); }

  .empty {
    text-align: center;
    color: var(--muted);
    padding: 24px 16px;
    font-size: 13px;
  }

  .add-member {
    display: flex;
    gap: 8px;
    padding: 12px;
    border-top: 1px solid var(--border);
  }
  .add-member input {
    flex: 1;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 10px 12px;
    font: inherit;
    font-size: 14px;
    background: var(--surface);
  }
  .add-member input:focus { outline: 2px solid var(--accent); }
  .add-member button {
    background: var(--ink);
    color: white;
    border: none;
    border-radius: 10px;
    padding: 0 16px;
    font: inherit;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
  }

  /* FAB */
  .fab {
    position: absolute;
    right: 24px;
    bottom: 100px;
    background: var(--ink);
    color: white;
    border: none;
    padding: 14px 20px;
    border-radius: 999px;
    font: inherit;
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 16px 32px -12px rgba(31, 41, 51, 0.45);
    z-index: 400;
  }
  .fab:active { transform: scale(0.97); }

  /* Bottom nav */
  .navbar {
    height: 72px;
    border-top: 1px solid var(--border);
    background: var(--surface);
    display: flex;
    padding: 8px 16px;
  }
  .nav-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 600;
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }
  .nav-item.active { color: var(--ink); }
  .nav-item .glyph {
    width: 28px; height: 28px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 8px;
    font-size: 16px;
  }
  .nav-item.active .glyph { background: var(--ink); color: white; }

  /* Modal */
  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(31, 41, 51, 0.4);
    backdrop-filter: blur(4px);
    z-index: 1000;
    display: none;
    align-items: flex-end;
    justify-content: center;
  }
  .modal-backdrop.show { display: flex; }
  .modal {
    background: var(--surface);
    width: 100%;
    max-width: 480px;
    border-radius: 24px 24px 0 0;
    padding: 24px 20px 32px;
    transform: translateY(0);
    animation: slideUp 0.25s ease;
  }
  @media (min-width: 600px) {
    .modal-backdrop { align-items: center; }
    .modal { border-radius: 24px; margin: 0 16px; }
  }
  @keyframes slideUp {
    from { transform: translateY(100%); }
    to { transform: translateY(0); }
  }
  .modal h3 {
    font-weight: 800;
    font-size: 20px;
    margin-bottom: 20px;
  }
  .field {
    margin-bottom: 14px;
  }
  .field label {
    display: block;
    font-size: 12px;
    font-weight: 700;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 6px;
  }
  .field input, .field select {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 14px;
    font: inherit;
    font-size: 15px;
    background: white;
    color: var(--ink);
  }
  .field input:focus, .field select:focus { outline: 2px solid var(--accent); }
  .modal-actions {
    display: flex;
    gap: 8px;
    margin-top: 8px;
  }
  .modal-actions button {
    flex: 1;
    padding: 14px;
    border-radius: 12px;
    font: inherit;
    font-weight: 700;
    font-size: 15px;
    cursor: pointer;
    border: none;
  }
  .btn-cancel {
    background: transparent;
    border: 1px solid var(--border) !important;
    color: var(--muted);
  }
  .btn-save { background: var(--ink); color: white; }

  /* Loader */
  .loader {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    z-index: 800;
    flex-direction: column;
    gap: 16px;
    color: var(--muted);
    font-size: 13px;
  }
  .loader.hidden { display: none; }
  .spinner {
    width: 32px; height: 32px;
    border: 3px solid var(--border);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* ─── Total card on main splitter view ─── */
  .total-card .split-btn {
    background: var(--ink);
    color: white;
    border: none;
    border-radius: 999px;
    padding: 9px 16px;
    font: inherit;
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
    flex-shrink: 0;
    transition: all 0.15s ease;
  }
  .total-card .split-btn:hover:not(:disabled) {
    background: var(--accent);
    transform: translateX(2px);
  }
  .total-card .split-btn:disabled {
    background: var(--unvisited);
    color: var(--muted);
    cursor: not-allowed;
  }
  .total-card .icon { background: #DCE5F2; color: var(--accent); font-size: 18px; }
  .total-card .body .t { font-size: 18px; font-weight: 800; letter-spacing: -0.02em; }

  /* ─── Split screen overlay ─── */
  .split-screen {
    position: absolute;
    inset: 0;
    background: var(--surface);
    z-index: 900;
    display: flex;
    flex-direction: column;
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    visibility: hidden;
  }
  .split-screen.show {
    transform: translateY(0);
    visibility: visible;
  }
  .split-header {
    padding: 16px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .split-header h2 {
    font-weight: 800;
    font-size: 20px;
    text-align: center;
    letter-spacing: -0.01em;
  }
  .back-btn, .equal-btn {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 7px 12px;
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    white-space: nowrap;
  }
  .back-btn:hover, .equal-btn:hover { background: var(--unvisited); }

  .split-body {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .big-total {
    background: white;
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 28px 16px;
    text-align: center;
  }
  .big-total-amount {
    font-weight: 800;
    font-size: 40px;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .big-total-label {
    color: var(--muted);
    font-size: 13px;
    font-weight: 500;
    margin-top: 4px;
  }

  .pct-row {
    padding: 14px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid var(--border);
  }
  .pct-row:last-child { border-bottom: none; }
  .pct-row .body { flex: 1; min-width: 0; }
  .pct-row .body .t {
    font-weight: 600;
    font-size: 14px;
  }
  .pct-row .body .s {
    font-size: 12px;
    color: var(--muted);
    margin-top: 2px;
  }
  .pct-input-wrap {
    display: flex;
    align-items: center;
    gap: 4px;
    background: white;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 4px 10px 4px 4px;
  }
  .pct-input-wrap:focus-within { outline: 2px solid var(--accent); }
  .pct-input {
    width: 56px;
    border: none;
    background: transparent;
    padding: 6px 4px;
    font: inherit;
    font-weight: 700;
    font-size: 14px;
    text-align: right;
    color: var(--ink);
  }
  .pct-input:focus { outline: none; }
  .pct-input::-webkit-inner-spin-button,
  .pct-input::-webkit-outer-spin-button {
    -webkit-appearance: none; margin: 0;
  }
  .pct-suffix {
    font-weight: 700;
    font-size: 13px;
    color: var(--muted);
  }

  .sum-indicator {
    text-align: center;
    padding: 12px 16px;
    border-radius: 12px;
    font-weight: 700;
    font-size: 13px;
    background: var(--visited);
    color: #1F5A41;
    border: 1px solid #9BCBB5;
    transition: all 0.2s ease;
  }
  .sum-indicator.invalid {
    background: var(--wishlist);
    color: #8C3624;
    border-color: #E8B299;
  }
  .auto-norm-btn {
    background: #8C3624;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 4px 10px;
    margin-left: 8px;
    font: inherit;
    font-weight: 700;
    font-size: 11px;
    cursor: pointer;
  }
  .auto-norm-btn:hover { background: var(--ink); }
</style>
</head>
<body>

<div class="app">

  <!-- ─────────── Top bar ─────────── -->
  <header class="topbar">
    <h1>Better<span>·</span>Been</h1>
    <div id="level-controls" class="segmented" style="display:none">
      <button data-level="country" class="active">Länder</button>
      <button data-level="subdivision">Regionen</button>
    </div>
  </header>

  <!-- ─────────── Tab 1: Map ─────────── -->
  <section class="tab active" id="tab-map">
    <div class="stats">
      <div class="stat visited">
        <div class="num" id="stat-visited">0</div>
        <div class="label">besucht</div>
      </div>
      <div class="stat wishlist">
        <div class="num" id="stat-wishlist">0</div>
        <div class="label">wunsch</div>
      </div>
      <div class="stat">
        <div class="num" id="stat-coverage">0 %</div>
        <div class="sub" id="stat-coverage-sub">0/0</div>
        <div class="label" id="stat-coverage-label">der welt</div>
      </div>
    </div>
    <div id="map" style="position: relative;">
      <div class="map-mode" id="mode-controls">
        <span class="mode-label">Klick markiert als</span>
        <div class="segmented mode-seg">
          <button data-mode="visited" class="active">Besucht</button>
          <button data-mode="wishlist">Wunsch</button>
        </div>
      </div>
      <div class="legend">
        <span><span class="dot" style="background:var(--visited)"></span>Besucht</span>
        <span><span class="dot" style="background:var(--wishlist)"></span>Wunsch</span>
      </div>
      <div class="toast" id="toast"></div>
      <div class="loader" id="loader">
        <div class="spinner"></div>
        <div>Karte wird geladen…</div>
      </div>
    </div>
  </section>

  <!-- ─────────── Tab 2: Splitter ─────────── -->
  <section class="tab" id="tab-splitter">
    <div class="splitter">
      <div class="trip-header">
        <input type="text" class="trip-name" id="trip-name" value="Italien 2026">
        <button class="ghost-btn trip-action-btn" id="trip-export-btn" title="Trip als JSON-Datei exportieren">↓ Export</button>
        <button class="ghost-btn trip-action-btn" id="trip-import-btn" title="Trip aus JSON importieren">↑ Import</button>
      </div>

      <div class="section-title">
        <span>Reisende</span>
      </div>
      <div class="card" id="members-card">
        <!-- member rows injected -->
      </div>

      <div class="card total-card">
        <div class="row">
          <div class="icon ic-blue">∑</div>
          <div class="body">
            <div class="t" id="total-amount">€0,00</div>
            <div class="s"><span id="total-count">0</span> Ausgaben gesammelt</div>
          </div>
          <button class="split-btn" id="open-split-btn" disabled>Splitten →</button>
        </div>
      </div>

      <div class="section-title">
        <span>Ausgaben</span>
        <button class="ghost-btn" id="reset-trip">Zurücksetzen</button>
      </div>
      <div class="card" id="expenses-card">
        <div class="empty">Tippe auf <strong>＋ Ausgabe</strong> unten rechts.</div>
      </div>

      <div style="height: 80px"></div>
    </div>

    <button class="fab" id="add-expense-btn">＋ Ausgabe</button>
  </section>

  <!-- ─────────── Modal: Import trip ─────────── -->
  <div class="modal-backdrop" id="import-modal">
    <div class="modal">
      <h3>Trip importieren</h3>
      <div class="field">
        <label>JSON einfügen</label>
        <textarea id="import-json" rows="8" style="width:100%; border:1px solid var(--border); border-radius:10px; padding:12px; font-family: ui-monospace, monospace; font-size: 12px; background: white; resize: vertical;"></textarea>
      </div>
      <div style="font-size: 12px; color: var(--muted); margin-top: -6px; margin-bottom: 14px;">
        Achtung: ersetzt den aktuellen Trip komplett.
      </div>
      <div class="modal-actions">
